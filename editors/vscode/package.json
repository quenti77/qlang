{
  "name": "qlang",
  "displayName": "qlang",
  "description": "Language support for qlang: syntax highlighting, errors as you type, hovers, completion, go to definition, references, rename, symbols, snippets and a Run command.",
  "version": "0.59.0",
  "publisher": "qlang",
  "license": "MIT",
  "engines": { "vscode": "^1.82.0" },
  "categories": ["Programming Languages", "Snippets"],
  "keywords": ["qlang"],
  "repository": { "type": "git", "url": "https://github.com/quenti77/qlang" },
  "main": "./extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "The path of the qlang executable is only taken from your user settings in an untrusted workspace: a downloaded project must not be able to choose which program runs.",
      "restrictedConfigurations": ["qlang.path"]
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "qlang",
        "aliases": ["qlang", "QLang"],
        "extensions": [".q"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "qlang",
        "scopeName": "source.qlang",
        "path": "./syntaxes/qlang.tmLanguage.json"
      }
    ],
    "snippets": [{ "language": "qlang", "path": "./snippets/qlang.json" }],
    "commands": [
      { "command": "qlang.run", "title": "qlang: Run File", "icon": "$(play)" },
      { "command": "qlang.restart", "title": "qlang: Restart Language Server" }
    ],
    "menus": {
      "editor/title/run": [
        { "command": "qlang.run", "when": "resourceLangId == qlang", "group": "navigation" }
      ],
      "commandPalette": [
        { "command": "qlang.run", "when": "editorLangId == qlang" },
        { "command": "qlang.restart", "when": "editorLangId == qlang" }
      ]
    },
    "configurationDefaults": {
      "[qlang]": {
        "editor.quickSuggestions": { "other": "on", "comments": "off", "strings": "on" }
      }
    },
    "configuration": {
      "title": "qlang",
      "properties": {
        "qlang.path": {
          "type": "string",
          "default": "qlang",
          "scope": "machine",
          "description": "The qlang executable (name in PATH, or a full path). Install it with `cargo install --path crates/qlang-cli` from the qlang repository."
        },
        "qlang.diagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show the errors the language server (`qlang lsp`) reports while you type."
        }
      }
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "package": "vsce package --allow-missing-repository"
  },
  "dependencies": {
    "vscode-languageclient": "11.0.0"
  },
  "devDependencies": {
    "@vscode/vsce": "^4.0.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.0.0"
  }
}
