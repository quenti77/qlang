{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "qlang",
  "scopeName": "source.qlang",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#types" },
    { "include": "#calls" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.documentation.qlang",
          "begin": "--\"",
          "end": "--\"",
          "beginCaptures": { "0": { "name": "punctuation.definition.comment.qlang" } },
          "endCaptures": { "0": { "name": "punctuation.definition.comment.qlang" } }
        },
        {
          "name": "comment.block.qlang",
          "begin": "--\\(",
          "end": "--\\)",
          "beginCaptures": { "0": { "name": "punctuation.definition.comment.qlang" } },
          "endCaptures": { "0": { "name": "punctuation.definition.comment.qlang" } }
        },
        {
          "name": "comment.line.double-dash.qlang",
          "match": "--(?![(\"]).*$"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.qlang",
      "begin": "\"",
      "end": "\"",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.qlang" } },
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.qlang" } },
      "patterns": [
        {
          "name": "constant.character.escape.qlang",
          "match": "\\\\[ntr0\\\\\"{}]"
        },
        {
          "name": "invalid.illegal.escape.qlang",
          "match": "\\\\."
        },
        {
          "name": "meta.interpolation.qlang",
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.qlang" } },
          "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.qlang" } },
          "contentName": "source.qlang.embedded",
          "patterns": [
            { "include": "#numbers" },
            { "include": "#keywords" },
            { "include": "#constants" },
            { "include": "#types" },
            { "include": "#calls" },
            { "include": "#operators" },
            { "include": "#punctuation" },
            { "include": "#interpolation-nested" }
          ]
        }
      ]
    },
    "interpolation-nested": {
      "begin": "\\{",
      "end": "\\}",
      "patterns": [{ "include": "#interpolation-nested" }, { "include": "$self" }]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.qlang",
          "match": "\\b0[xX][0-9a-fA-F]+(?:_[0-9a-fA-F]+)*\\b"
        },
        {
          "name": "constant.numeric.binary.qlang",
          "match": "\\b0[bB][01]+(?:_[01]+)*\\b"
        },
        {
          "name": "constant.numeric.float.qlang",
          "match": "\\b\\d+(?:_\\d+)*\\.\\d+(?:_\\d+)*(?:[eE][+-]?\\d+(?:_\\d+)*)?\\b|\\b\\d+(?:_\\d+)*[eE][+-]?\\d+(?:_\\d+)*\\b"
        },
        {
          "name": "constant.numeric.integer.qlang",
          "match": "\\b\\d+(?:_\\d+)*\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(fun)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.function.qlang" },
            "2": { "name": "entity.name.function.qlang" }
          }
        },
        {
          "match": "\\b(struct|trait|enum)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.class.qlang" },
            "2": { "name": "entity.name.type.qlang" }
          }
        },
        {
          "match": "\\b(extends)\\s+([A-Za-z_][A-Za-z0-9_.]*)",
          "captures": {
            "1": { "name": "storage.modifier.extends.qlang" },
            "2": { "name": "entity.other.inherited-class.qlang" }
          }
        },
        {
          "match": "\\b(let|const)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.variable.qlang" },
            "2": { "name": "variable.other.definition.qlang" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.flow.qlang",
          "match": "\\b(if|then|elseif|else|end|while|for|in|step|do|break|continue|match|case|return)\\b"
        },
        {
          "name": "storage.type.qlang",
          "match": "\\b(fun|struct|impl|trait|enum|let|const)\\b"
        },
        {
          "name": "storage.modifier.qlang",
          "match": "\\b(public|private|protected|static|override|extends)\\b"
        },
        {
          "name": "keyword.control.import.qlang",
          "match": "\\b(import|export|from|as)\\b"
        },
        {
          "name": "keyword.operator.assignment.word.qlang",
          "match": "\\b(div|mod)="
        },
        {
          "name": "keyword.operator.word.qlang",
          "match": "\\b(and|or|not|div|mod)\\b"
        },
        {
          "name": "variable.language.qlang",
          "match": "\\b(self|super)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        { "name": "constant.language.boolean.qlang", "match": "\\b(true|false)\\b" },
        { "name": "constant.language.null.qlang", "match": "\\bnone\\b" },
        { "name": "constant.other.qlang", "match": "\\b[A-Z][A-Z0-9_]+\\b" }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.builtin.qlang",
          "match": "\\b(int|float|bool|string|array|map|range)\\b(?=\\s*(?:<|\\?|,|\\)|=|$|\\.|\\[))"
        },
        {
          "name": "entity.name.type.qlang",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "calls": {
      "patterns": [
        {
          "match": "\\.\\s*([a-z_][A-Za-z0-9_]*)\\s*(?=[(<])",
          "captures": { "1": { "name": "entity.name.function.member.qlang" } }
        },
        {
          "match": "\\.\\s*([a-z_][A-Za-z0-9_]*)",
          "captures": { "1": { "name": "variable.other.property.qlang" } }
        },
        {
          "match": "\\b(print|write|read|panic|assert)\\b(?=\\s*\\()",
          "captures": { "1": { "name": "support.function.builtin.qlang" } }
        },
        {
          "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": { "1": { "name": "entity.name.function.call.qlang" } }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.qlang",
          "match": "\\+=|-=|\\*=|/=|%=|=(?!=)"
        },
        { "name": "keyword.operator.comparison.qlang", "match": "==|!=|<=|>=|<|>" },
        { "name": "keyword.operator.range.qlang", "match": "\\.\\.=|\\.\\." },
        { "name": "keyword.operator.arrow.qlang", "match": "->" },
        { "name": "keyword.operator.arithmetic.qlang", "match": "\\*\\*|[+\\-*/%]" },
        { "name": "keyword.operator.nullable.qlang", "match": "\\?" }
      ]
    },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.separator.comma.qlang", "match": "," },
        { "name": "punctuation.separator.colon.qlang", "match": ":" },
        { "name": "punctuation.accessor.qlang", "match": "\\." },
        { "name": "punctuation.definition.brackets.qlang", "match": "[()\\[\\]{}]" }
      ]
    }
  }
}
