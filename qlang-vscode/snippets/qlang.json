{
  "si": {
    "prefix": "si",
    "body": ["si ${1:condition} alors", "\t$0", "fin"],
    "description": "Bloc conditionnel si"
  },
  "si sinon": {
    "prefix": "sisinon",
    "body": ["si ${1:condition} alors", "\t$2", "sinon", "\t$0", "fin"],
    "description": "Bloc conditionnel si/sinon"
  },
  "tantque": {
    "prefix": "tantque",
    "body": ["tantque ${1:condition} alors", "\t$0", "fin"],
    "description": "Boucle tantque"
  },
  "pour": {
    "prefix": "pour",
    "body": ["pour ${1:i} de ${2:0} jusque ${3:10} alors", "\t$0", "fin"],
    "description": "Boucle pour"
  },
  "fonction": {
    "prefix": "fonction",
    "body": ["fonction ${1:nom}(${2:parametres})", "\t$0", "fin"],
    "description": "Déclaration de fonction"
  },
  "inclure": {
    "prefix": "inclure",
    "body": "inclure \"${1:chemin.q}\"",
    "description": "Inclusion d'un fichier module"
  },
  "dec": {
    "prefix": "dec",
    "body": "dec ${1:nom} = ${0:valeur}",
    "description": "Déclaration de variable"
  },
  "constante": {
    "prefix": "constante",
    "body": "constante ${1:nom} = ${0:valeur}",
    "description": "Déclaration de constante"
  },
  "selon": {
    "prefix": "selon",
    "body": ["selon ${1:valeur}", "cas ${2:motif} alors", "\t$0", "fin"],
    "description": "Bloc de comparaison à plusieurs cas (match)"
  },
  "ecrire": {
    "prefix": "ecrire",
    "body": "ecrire ${0:valeur}",
    "description": "Affiche une valeur"
  },
  "structure": {
    "prefix": "structure",
    "body": ["structure ${1:Nom} avec", "\tpublique ${0:champ}", "fin"],
    "description": "Déclaration d'une structure"
  },
  "implemente": {
    "prefix": "implemente",
    "body": ["dans ${1:Nom} implemente", "\tpublique ${2:methode}(moi, ${3:parametres})", "\t\t$0", "\tfin", "fin"],
    "description": "Bloc de méthodes d'une structure (méthode d'instance : 1er paramètre moi)"
  }
}
